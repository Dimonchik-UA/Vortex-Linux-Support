[Desktop Entry]
Type=Application
Version=1.0
Name=OVLS Installer
Comment=Установка, проверка и удаление Linux Support для официального Vortex
Exec=sh -c "exec bash \\"\\$(dirname \\"\\$1\\")/install.sh\\"" sh %k
